    "spec_yaml": "document:\n  dsl: '1.0.3'\n  namespace: system\n  name: agent-engine\n  version: '2.1.0'\n  metadata:\n    description: >\n      The core agent. Every A3T agent runs through it: an A3T agent flow declares\n      metadata.a3t.extends: system/agent-engine@2.1.0 and runs this flow with its own\n      config. Each turn it (1) recalls reference knowledge from SEMANTIC memory\n      (FlowR docs, namespace system-knowledge), (2) recalls the tools that fit the\n      request from its tool catalogue in PROCEDURAL memory (namespace system-tools),\n      (3) runs the turn (system/agent-turn, the native engine), which recalls and writes the\n      agent's WORKING and EPISODIC memory on ADB, and (4) writes one row per turn to\n      a3t_agent_turns. A failed recall or log write never stops the turn: it is\n      reported to system/a3t-error-handler (one a3t_errors row) and the turn goes on\n      without it. A failed turn fails the run, and the base's error handler answers\n      it. See AGENT_ENGINE.md next to this file.\n      Input: { message, session_id, ui_context?, config? }. Output: { content,\n      session_id, tool_calls_made, iterations, procedural_hit, stopped_reason,\n      knowledge, tool_hints, degraded }.\n\nmetadata:\n  a3t:\n    extends: system/a3t-base@1.0.0\n    # Children inherit the hooks below and the base's error handler. Turn logging\n    # is part of this flow's steps, which a child can't remove; memory stays each\n    # agent's own setting (config.memory_resource: null turns it off).\n    locked:\n      - onError\n\ndo:\n  # ═══ 1. Settings: the core's defaults under the agent's own config ═══════════\n  - core_setup:\n      set:\n        _in: '${ . // {} }'\n        _started: '${ now }'\n        _soft: []\n        _knowledge: []\n        _tools: []\n        _cfg: >-\n          ${ {\n              system_prompt: \"You are a helpful assistant.\",\n              memory_resource: \"a3t/adb\",\n              memory_namespace: \"default\",\n              memory_config: {\n                working: {read: true, write: true},\n                episodic: {read: true, write: true},\n                semantic: {read: true},\n                procedural: {read: false}\n              },\n              knowledge: {enabled: true, namespace: \"system-knowledge\", limit: 4, max_chars: 600},\n              tool_catalogue: {enabled: true, namespace: \"system-tools\", limit: 6}\n            } * (.config // {}) }\n      export:\n        as: '${ $context + . }'\n\n  - core_where:\n      set:\n        # Knowledge and the tool catalogue live on the org's ADB unless the agent\n        # names another one; with no ADB at all they are skipped.\n        _k_res: '${ $context._cfg.knowledge.resource // $context._cfg.memory_resource }'\n        _t_res: '${ $context._cfg.tool_catalogue.resource // $context._cfg.memory_resource }'\n        _ask: '${ ($context._in.message // \"\") | tostring }'\n        _who: '${ (($context._principal // {}).user // \"\") | tostring }'\n        # The run id. $workflow is null in a subflow (engine request CA-R2), and\n        # every A3T agent runs the core as one: empty there until that lands.\n        _run: '${ (($workflow // {}).id // \"\") | tostring }'\n      export:\n        as: '${ $context + . }'\n\n  # ═══ 2. Reference knowledge (SEMANTIC) ══════════════════════════════════════\n  - recall_knowledge:\n      if: '${ $context._cfg.knowledge.enabled == true and $context._k_res != null and ($context._ask | length) > 0 }'\n      try:\n        do:\n          - knowledge_query:\n              call: adb\n              with:\n                query: '${ \"RECALL FROM SEMANTIC LIKE $q NAMESPACE \\\"\" + $context._cfg.knowledge.namespace + \"\\\" LIMIT \" + ($context._cfg.knowledge.limit | tostring) }'\n                variables:\n                  q: '${ $context._ask }'\n                _resource: '${ $context._k_res }'\n              export:\n                as: '${ $context + {_knowledge: ((.data.records // .data.data.records // .records // []) | map(.data))} }'\n        catch:\n          do:\n            - knowledge_failed:\n                run:\n                  workflow:\n                    namespace: system\n                    name: a3t-error-handler\n                    input:\n                      error: '${ $context.error }'\n                      flow: system/agent-engine\n                      version: 2.1.0\n                      run_id: '${ $context._run }'\n                      principal: '${ $context._who }'\n                      step: recall_knowledge\n                export:\n                  as: '${ $context + {_soft: ($context._soft + [{step: \"recall_knowledge\", class: .class, ref: .ref}])} }'\n\n  # ═══ 3. Tools that fit the request (PROCEDURAL tool catalogue) ══════════════\n  - recall_tools:\n      if: '${ $context._cfg.tool_catalogue.enabled == true and $context._t_res != null and ($context._ask | length) > 0 }'\n      try:\n        do:\n          - tools_query:\n              call: adb\n              with:\n                query: '${ \"RECALL FROM PROCEDURAL LIKE $m NAMESPACE \\\"\" + $context._cfg.tool_catalogue.namespace + \"\\\" LIMIT \" + ($context._cfg.tool_catalogue.limit | tostring) }'\n                variables:\n                  m: '${ $context._ask }'\n                _resource: '${ $context._t_res }'\n              export:\n                as: '${ $context + {_tools: ((.data.records // .data.data.records // .records // []) | map(.data) | map(select(.kind == \"tool\")))} }'\n        catch:\n          do:\n            - tools_failed:\n                run:\n                  workflow:\n                    namespace: system\n                    name: a3t-error-handler\n                    input:\n                      error: '${ $context.error }'\n                      flow: system/agent-engine\n                      version: 2.1.0\n                      run_id: '${ $context._run }'\n                      principal: '${ $context._who }'\n                      step: recall_tools\n                export:\n                  as: '${ $context + {_soft: ($context._soft + [{step: \"recall_tools\", class: .class, ref: .ref}])} }'\n\n  # ═══ 4. The prompt: the agent's own, then what was recalled ════════════════\n  - assemble_prompt:\n      set:\n        _prompt: >-\n          ${ ($context._cfg.system_prompt // \"You are a helpful assistant.\")\n          + (if ($context._knowledge | length) > 0 then\n              \"\\n\\n## Reference\\nFrom the platform documentation, most relevant first. Use it when it applies; if it doesn't cover the question, say so rather than guess.\\n\"\n              + ($context._knowledge\n                 | map(\"- \" + (if .title then \"**\" + .title + \"** \" else \"\" end)\n                       + ((.content // \"\") | tostring | if length > $context._cfg.knowledge.max_chars then .[0:$context._cfg.knowledge.max_chars] + \"…\" else . end)\n                       + (if .source then \" (\" + .source + \")\" else \"\" end))\n                 | join(\"\\n\"))\n             else \"\" end)\n          + (if ($context._tools | length) > 0 then\n              \"\\n\\n## Tools that fit this request\\nFrom your tool catalogue. Use the tool's own description and schema when you call it.\\n\"\n              + ($context._tools | map(\"- `\" + (.name // .key) + \"` — \" + ((.usage // .description // .pattern // \"\") | tostring)) | join(\"\\n\"))\n             else \"\" end) }\n      export:\n        as: '${ $context + . }'\n\n  # ═══ 5. The turn (system/agent-turn: memory, LLM, tools, session) ════════\n  # Its own flow because call: a3t:agent replaces the calling flow's $context with\n  # the turn's (engine request CA-R1); the core's own state stays here.\n  - run_agent:\n      run:\n        workflow:\n          namespace: system\n          name: agent-turn\n          input:\n            config: '${ $context._cfg + {system_prompt: $context._prompt} }'\n            session_id: '${ $context._in.session_id // \"default\" }'\n            message: '${ $context._ask }'\n            ui_context: '${ $context._in.ui_context // null }'\n      export:\n        as: '${ $context + {_turn: .} }'\n\n  # ═══ 6. One row per turn ═══════════════════════════════════════════════════\n  - log_turn:\n      try:\n        do:\n          - turn_row:\n              call: lancedb\n              with:\n                operation: insert\n                table: a3t_agent_turns\n                records:\n                  - id: '${ \"turn-\" + ((now * 1000000) | floor | tostring) + \"-\" + ($context._in.session_id // \"default\") }'\n                    at: '${ now | todateiso8601 }'\n                    run_id: '${ $context._run }'\n                    session_id: '${ $context._in.session_id // \"default\" }'\n                    agent_id: '${ ($context._in.session_id // \"\") | split(\":\") | if length > 1 then .[0] else \"\" end }'\n                    principal: '${ $context._who }'\n                    llm: '${ $context._cfg.llm_resource // \"\" }'\n                    memory: '${ if $context._cfg.memory_resource then $context._cfg.memory_resource + \" · \" + $context._cfg.memory_namespace else \"off\" end }'\n                    outcome: '${ $context._turn.stopped_reason // \"answered\" }'\n                    iterations: '${ ($context._turn.iterations // 0) | tostring }'\n                    tool_calls: '${ ($context._turn.tool_calls_made // 0) | tostring }'\n                    procedural_hit: '${ ($context._turn.procedural_hit // false) | tostring }'\n                    knowledge: '${ $context._knowledge | map(.key // .title // \"\") | join(\",\") }'\n                    tool_hints: '${ $context._tools | map(.name // .key // \"\") | join(\",\") }'\n                    degraded: '${ $context._soft | map(.step) | join(\",\") }'\n                    duration_ms: '${ ((now - $context._started) * 1000 | floor) | tostring }'\n                _resource: a3t/a3t-platform-db\n        catch:\n          do:\n            - log_failed:\n                run:\n                  workflow:\n                    namespace: system\n                    name: a3t-error-handler\n                    input:\n                      error: '${ $context.error }'\n                      flow: system/agent-engine\n                      version: 2.1.0\n                      run_id: '${ $context._run }'\n                      principal: '${ $context._who }'\n                      step: log_turn\n                export:\n                  as: '${ $context + {_soft: ($context._soft + [{step: \"log_turn\", class: .class, ref: .ref}])} }'\n\n  # ═══ 7. The answer ═════════════════════════════════════════════════════════\n  - emit:\n      set:\n        content: '${ $context._turn.content }'\n        session_id: '${ $context._turn.session_id }'\n        tool_calls_made: '${ $context._turn.tool_calls_made }'\n        iterations: '${ $context._turn.iterations }'\n        procedural_hit: '${ $context._turn.procedural_hit }'\n        stopped_reason: '${ $context._turn.stopped_reason }'\n        knowledge: '${ $context._knowledge | map(.key // .title) }'\n        tool_hints: '${ $context._tools | map(.name // .key) }'\n        degraded: '${ $context._soft }'\n",
    "tags": "core,lifecycle,multi-turn,tool-use,memory,knowledge,tool-catalogue,turn-log,rust-native",
